<?xml version="1.0" encoding="utf-8"?>
<!--
  Raspberry Pi Zero W interface configuration.
  SPI1 (overlay spi1-3cs): bus="1", device 0/1/2 = CE0(GPIO18)/CE1(GPIO17)/CE2(GPIO16)
  The numbers in <pin gpio="..."> use the BCM (GPIO) numbering, not the physical pin numbers.
-->
<interfaces>

  <spi_device name="RC522" type="rfid" bus="1" device="0" speed_hz="1000000" mode="0">
    <pin name="RST" gpio="22"/>
  </spi_device>

  <spi_device name="NRF24" type="radio" bus="1" device="1" speed_hz="4000000" mode="0">
    <pin name="CE"  gpio="23"/>
    <pin name="IRQ" gpio="26"/>
  </spi_device>

  <spi_device name="CC1101" type="radio" bus="1" device="2" speed_hz="4000000" mode="0">
    <pin name="GDO0" gpio="27"/>
    <pin name="GDO2" gpio="12"/>
  </spi_device>

  <!-- GPIO14 (TXD) / GPIO15 (RXD); thanks to the miniuart-bt overlay, /dev/serial0 points to the PL011 -->
  <uart_device name="GPS" type="gps" port="/dev/serial0" baudrate="9600" timeout="0.5"/>

</interfaces>
