<?xml version="1.0" encoding="utf-8"?>
<!-- Port configuration for nrf24_spectrum.py.
     SPI1 (aux) by default, because SPI0 is used by the LCD display.
     Requires in /boot/firmware/config.txt:  dtoverlay=spi1-1cs
     Wiring (BCM numbers / physical pin):
       SCK  -> GPIO21 (40)    MOSI -> GPIO20 (38)    MISO -> GPIO19 (35)
       CSN  -> GPIO18 (12)  = bus 1, device 0
       CE   -> GPIO22 (15)    VCC -> 3V3 (17) + a 10 uF capacitor    GND -> (14)
-->
<spi_cfg>
  <spi bus="1" device="0" speed_hz="4000000" mode="0"/>
  <gpio chip="0" ce="22"/>
  <!-- dwell_us: listen time per channel (minimum approx. 130); sweeps: passes averaged into one frame;
       data_rate: 250K | 1M | 2M -->
  <scan channel_min="0" channel_max="125" dwell_us="170" sweeps="6" data_rate="2M"/>
  <display height="12"/>
</spi_cfg>
